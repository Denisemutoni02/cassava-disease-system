# Copy to .env and edit before running:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# Every value below has a working default in app/config.py — deleting this
# file still boots a working local instance. Relative paths are resolved from
# the project root (MODEL_PATH) or from backend/ (UPLOAD_DIR).

# --- Database ---------------------------------------------------------------
# Default / demo: SQLite — zero setup, file created next to this .env.
DATABASE_URL=sqlite+aiosqlite:///./cassava_guard.db

# Production / multi-user: PostgreSQL + PostGIS (start it with
# `docker compose up -d db` from the project root, then uncomment):
# DATABASE_URL=postgresql+asyncpg://cassava:cassava@localhost:5432/cassava

# --- Auth -------------------------------------------------------------------
# CHANGE THE SECRET before any real deployment!
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- ML model ---------------------------------------------------------------
# Quantised MobileNetV2 artefact (.onnx or .tflite), loaded ONCE at startup.
# Relative paths resolve from the project root, so this works on any machine.
# If the file is missing the API falls back to a deterministic mock classifier
# (check /health -> "classifier": "mock").
MODEL_PATH=ml/models/mobilenetv2_cassava.onnx
# Alternative (needs tflite-runtime/tensorflow installed):
# MODEL_PATH=ml/models/mobilenetv2_cassava_dynamic.tflite
CONFIDENCE_THRESHOLD=0.60
FORCE_MOCK_MODEL=false

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Hotspot clustering (DBSCAN) -------------------------------------------
CLUSTER_EPS_M=2000
CLUSTER_MIN_SAMPLES=3
CLUSTER_WINDOW_DAYS=90

# --- CORS -------------------------------------------------------------------
# Vite dev server; use * to allow any origin (LAN / phone testing).
# Not used when the API also serves the built frontend (SERVE_FRONTEND=true).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Serve the built SPA from the API (single-host deployment) --------------
# Serves frontend/dist at / when it exists. Dev leaves it false.
SERVE_FRONTEND=false

# --- Environment ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
